# Copie para .env e substitua os valores SUBSTITUA antes de iniciar.
# Nunca publique o .env ou as chaves reais.
NODE_ENV=development
PORT=3000
TRUST_PROXY=0

# Banco local: DATABASE_URL (Prisma CLI) e DB_* (API/seed/worker)
# devem apontar para o mesmo banco. Codifique caracteres especiais na URL.
DATABASE_URL="mysql://novacki:SUBSTITUA_SENHA_DO_BANCO@127.0.0.1:3306/novacki_denuncias"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=novacki
DB_PASS=SUBSTITUA_SENHA_DO_BANCO
DB_NAME=novacki_denuncias
DATABASE_CONNECTION_LIMIT=5
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=C:/certificados/ca.pem

# Origem do frontend; separe várias origens por vírgula, sem barra final.
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_LOCALHOST=false
ADMIN_COOKIE_NAME=nvk_admin_session
REPORTER_COOKIE_NAME=nvk_reporter_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_SESSION_DAYS=7
REPORTER_SESSION_DURATION_MS=3600000
USER_CREDENTIAL_TOKEN_MINUTES=30
ADMIN_PRE_AUTH_EXPIRES_IN=10m

# Gere dois segredos independentes com o comando hexadecimal do README.
ADMIN_PRE_AUTH_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_HEXADECIMAL
RATE_LIMIT_HMAC_KEY=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO_HEXADECIMAL

# Chave de exatamente 32 bytes em Base64 (comando no README).
REPORT_ENCRYPTION_KEY_VERSION=1
REPORT_ENCRYPTION_KEY_V1=SUBSTITUA_POR_CHAVE_BASE64_DE_32_BYTES

# Cloudflare R2: obrigatório na inicialização; use um bucket de desenvolvimento.
R2_ACCOUNT_ID=SUBSTITUA_ACCOUNT_ID
R2_ACCESS_KEY_ID=SUBSTITUA_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=SUBSTITUA_SECRET_ACCESS_KEY
R2_BUCKET_NAME=SUBSTITUA_BUCKET_NAME
MAX_ATTACHMENT_MB=20

# Administrador e empresa criados pelo seed.
SEED_COMPANY_CODE=NVK
SEED_COMPANY_NAME=Novacki
SEED_ADMIN_NAME="Administrador local"
SEED_ADMIN_EMAIL=admin@example.com
# Defina uma senha própria com pelo menos 12 caracteres.
SEED_ADMIN_PASSWORD=SUBSTITUA_SENHA_ADMIN

# Processamento em segundo plano, iniciado separadamente da API.
SYSTEM_WORKER_ENABLED=false
SYSTEM_WORKER_INTERVAL_MS=60000
RETENTION_SCHEDULER_ENABLED=false
RETENTION_EXECUTOR_ENABLED=false
R2_PURGE_MAX_ATTEMPTS=8
R2_PURGE_RETRY_BASE_MS=60000
R2_PURGE_RETRY_MAX_MS=3600000

# Scanner de anexos: requer ClamAV instalado e acessível pelo processo.
CLAMAV_COMMAND=clamdscan
CLAMAV_MODE=daemon
CLAMAV_TIMEOUT_MS=60000

# Opcional: descomente e preencha para habilitar notificações por e-mail.
# Não deixe variáveis opcionais vazias: algumas são validadas se presentes.
EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=SUBSTITUA_USUARIO_SMTP
# SMTP_PASS=SUBSTITUA_SENHA_SMTP
# SMTP_FROM="Novacki Denuncias <denuncias@example.com>"
# ADMIN_PANEL_URL=http://localhost:5173
# GLOBAL_NOTIFICATION_EMAIL=notificacoes@example.com
